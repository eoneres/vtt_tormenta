# ─── identity-service — .env.example ─────────────────────────────────────────
# Copy to .env.local and fill in values. NEVER commit .env.local

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vtt
POSTGRES_PASSWORD=<postgres_password>
POSTGRES_DB=vtt_identity
POSTGRES_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<redis_password>
REDIS_TLS=false

# JWT — RS256 keys (generate with: openssl genrsa -out private.pem 4096)
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n<private_key_here>\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<public_key_here>\n-----END PUBLIC KEY-----"
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000
JWT_ISSUER=vtt-platform

# OAuth2 (optional)
OAUTH_GOOGLE_CLIENT_ID=<google_client_id>
OAUTH_GOOGLE_CLIENT_SECRET=<google_client_secret>
OAUTH_DISCORD_CLIENT_ID=<discord_client_id>
OAUTH_DISCORD_CLIENT_SECRET=<discord_client_secret>

# RabbitMQ
RABBITMQ_URI=amqp://vtt:<password>@localhost:5672

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=identity-service
OTEL_SERVICE_VERSION=0.0.1
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Security
IP_HASH_SALT=<random_32_char_string>
