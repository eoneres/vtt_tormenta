{
  "name": "@vtt/realtime-gateway-service",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/main",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@colyseus/monitor": "^0.15.0",
    "@colyseus/redis-presence": "^0.15.0",
    "@colyseus/redis-driver": "^0.15.0",
    "@vtt/shared-events": "workspace:*",
    "@vtt/shared-types": "workspace:*",
    "@vtt/shared-utils": "workspace:*",
    "colyseus": "^0.15.21",
    "express": "^4.19.2",
    "ioredis": "^5.3.2",
    "prom-client": "^15.1.2",
    "undici": "^6.18.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
