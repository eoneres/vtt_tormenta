{
  "title": "VTT Platform — Overview",
  "uid": "vtt-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["vtt", "platform", "overview"],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(up, namespace)",
        "regex": "vtt-.+",
        "current": { "value": "vtt-production" }
      },
      {
        "name": "service",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(up{namespace=\"$namespace\"}, job)",
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Services Health",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } }
          ]
        }
      },
      "targets": [
        { "expr": "up{namespace=\"$namespace\",job=~\"$service\"}", "legendFormat": "{{job}}" }
      ]
    },
    {
      "id": 2,
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(http_requests_total{namespace=\"$namespace\",job=~\"$service\"}[5m])) by (job)", "legendFormat": "{{job}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 3,
      "title": "Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "100 * sum(rate(http_requests_total{namespace=\"$namespace\",job=~\"$service\",status=~\"5..\"}[5m])) by (job) / sum(rate(http_requests_total{namespace=\"$namespace\",job=~\"$service\"}[5m])) by (job)",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "steps": [{"color":"green","value":0},{"color":"yellow","value":1},{"color":"red","value":5}] } } }
    },
    {
      "id": 4,
      "title": "P95 Latency (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{namespace=\"$namespace\",job=~\"$service\"}[5m])) by (le, job)) * 1000",
          "legendFormat": "{{job}} p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "steps": [{"color":"green","value":0},{"color":"yellow","value":200},{"color":"red","value":500}] } } }
    },
    {
      "id": 5,
      "title": "Active Realtime Rooms",
      "type": "stat",
      "gridPos": { "x": 12, "y": 12, "w": 6, "h": 4 },
      "targets": [{ "expr": "colyseus_rooms_active{namespace=\"$namespace\"}", "legendFormat": "Active Rooms" }],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [{"color":"green","value":0},{"color":"yellow","value":80},{"color":"red","value":120}] } } }
    },
    {
      "id": 6,
      "title": "WebSocket Connections",
      "type": "stat",
      "gridPos": { "x": 18, "y": 12, "w": 6, "h": 4 },
      "targets": [{ "expr": "colyseus_clients_connected{namespace=\"$namespace\"}", "legendFormat": "Connections" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 7,
      "title": "State Sync P95 (ms)",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 16, "w": 6, "h": 4 },
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(colyseus_patch_broadcast_duration_seconds_bucket{namespace=\"$namespace\"}[5m])) * 1000", "legendFormat": "Sync P95" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0, "max": 200, "thresholds": { "steps": [{"color":"green","value":0},{"color":"yellow","value":50},{"color":"red","value":100}] } } }
    },
    {
      "id": 8,
      "title": "Dice Rolls / second",
      "type": "stat",
      "gridPos": { "x": 18, "y": 16, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(rate(vtt_dice_rolls_total{namespace=\"$namespace\"}[1m]))", "legendFormat": "Rolls/s" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 9,
      "title": "CPU Usage by Service (%)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "100 * sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",container!=\"\"}[5m])) by (pod) / sum(kube_pod_container_resource_limits{resource=\"cpu\",namespace=\"$namespace\"}) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 } }
    },
    {
      "id": 10,
      "title": "Memory Usage by Service (%)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "100 * sum(container_memory_working_set_bytes{namespace=\"$namespace\",container!=\"\"}) by (pod) / sum(kube_pod_container_resource_limits{resource=\"memory\",namespace=\"$namespace\"}) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 } }
    },
    {
      "id": 11,
      "title": "Compendium — Search Latency P95",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 28, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"compendium-service\",handler=~\".*/entries.*\"}[5m])) * 1000",
          "legendFormat": "Search P95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 12,
      "title": "Redis Hit Rate (%)",
      "type": "gauge",
      "gridPos": { "x": 8, "y": 28, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "100 * rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m]))",
          "legendFormat": "Cache Hit Rate"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "steps": [{"color":"red","value":0},{"color":"yellow","value":70},{"color":"green","value":90}] } } }
    },
    {
      "id": 13,
      "title": "Active Alerts",
      "type": "alertlist",
      "gridPos": { "x": 16, "y": 28, "w": 8, "h": 6 },
      "options": { "maxItems": 10, "stateFilter": { "firing": true, "pending": true } }
    }
  ]
}
